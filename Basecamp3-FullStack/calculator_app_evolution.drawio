        <mxCell id="b1" value="$ python calculator.py&#10;&#10;Enter a: 4&#10;Enter b: 5&#10;Enter operation: add&#10;&#10;Result: 9" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#002726;strokeColor=#114741;strokeWidth=1;fontColor=#e6f5ee;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontFamily=Courier New;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="170" y="200" width="240" height="200" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="calculator.py&#10;&#10;def add(a, b):&#10;    return a + b&#10;&#10;def subtract(a, b): ...&#10;def multiply(a, b): ...&#10;def divide(a, b): ..." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf7f0;strokeColor=#33c375;strokeWidth=2;fontColor=#002726;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="490" y="200" width="220" height="200" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="calls add(4, 5)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#1f8756;strokeWidth=2;fontColor=#002726;fontSize=12;endArrow=block;endFill=1;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;labelBackgroundColor=#f2f9f6;" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="returns 9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#7a8f88;strokeWidth=2;dashed=1;fontColor=#002726;fontSize=12;endArrow=block;endFill=1;exitX=0;exitY=0.65;exitDx=0;exitDy=0;entryX=1;entryY=0.65;entryDx=0;entryDy=0;labelBackgroundColor=#f2f9f6;" edge="1" parent="1" source="b2" target="b1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="cap1" value="Nothing here is reachable from outside this machine -- no other program, phone, or teammate can call these functions." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#536b64;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="120" y="545" width="1000" height="40" as="geometry" />
        </mxCell>

        <mxCell id="head1" value="ALTERNATIVE TECHNOLOGY CHOICES AT THIS STAGE" style="text;html=0;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#002726;" vertex="1" parent="1">
