        </mxCell>
        <mxCell id="panelLang" value="PROGRAMMING LANGUAGE CHOICES&#10;&#10;- Python (used in this example)&#10;- JavaScript / Node.js&#10;- Java&#10;- C# (.NET)&#10;- Go&#10;- Ruby" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf7f0;strokeColor=#33c375;strokeWidth=2;fontColor=#002726;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=13;" vertex="1" parent="1">
