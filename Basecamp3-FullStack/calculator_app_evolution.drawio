  <diagram id="stage4" name="4 - Full-Stack with Database">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="STAGE 4 &#183; FULL-STACK WITH A DATABASE" style="text;html=0;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#002726;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Every calculation is saved -- the app becomes a complete, persistent system." style="text;html=0;align=left;verticalAlign=middle;fontSize=13;fontColor=#536b64;" vertex="1" parent="1">
          <mxGeometry x="60" y="62" width="800" height="24" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="Front-End App" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f9f6;strokeColor=#d9ece3;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=12;fontSize=16;fontStyle=1;fontColor=#002726;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="320" height="430" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Server -- FastAPI + uvicorn" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f9f6;strokeColor=#d9ece3;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=12;fontSize=16;fontStyle=1;fontColor=#002726;" vertex="1" parent="1">
          <mxGeometry x="470" y="110" width="340" height="430" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Database" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f9f6;strokeColor=#d9ece3;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=12;fontSize=16;fontStyle=1;fontColor=#002726;" vertex="1" parent="1">
          <mxGeometry x="900" y="110" width="320" height="430" as="geometry" />
        </mxCell>

        <mxCell id="ui1" value="Calculator&#10;&#10;a: [ 4 ]   b: [ 5 ]&#10;Operation: [ Add ]&#10;[ Calculate ]&#10;&#10;Result: 9&#10;&#10;History&#10;4 + 5 = 9&#10;10 / 2 = 5" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#1f8756;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;fontColor=#002726;" vertex="1" parent="1">
          <mxGeometry x="90" y="180" width="260" height="300" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="main.py&#10;&#10;@app.get('/history')&#10;@app.post('/calculate')&#10;@app.put('/calculate/{id}')&#10;@app.delete('/calculate/{id}')&#10;&#10;reads, creates, updates,&#10;and deletes rows" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf7f0;strokeColor=#33c375;strokeWidth=2;fontColor=#002726;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="190" width="280" height="170" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="uvicorn main:app --reload&#10;http://127.0.0.1:8000" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#002726;strokeColor=#114741;strokeWidth=1;fontColor=#e6f5ee;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontFamily=Courier New;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="375" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="served by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#1f8756;strokeWidth=2;fontColor=#002726;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#f2f9f6;" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="SQLite / PostgreSQL&#10;&#10;calculations table&#10;&#10;id | a | b | op | result&#10;1  | 4 | 5 | add | 9&#10;2  | 10 | 2 | div | 5" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff8e6;strokeColor=#e0a800;strokeWidth=2;fontColor=#002726;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="930" y="220" width="260" height="220" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="POST /calculate {a,b,op}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#1f8756;strokeWidth=2;fontColor=#002726;fontSize=11;endArrow=block;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;labelBackgroundColor=#f2f9f6;" edge="1" parent="1" source="ui1" target="b1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="{result, history}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#7a8f88;strokeWidth=2;dashed=1;fontColor=#002726;fontSize=11;endArrow=block;endFill=1;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;labelBackgroundColor=#f2f9f6;" edge="1" parent="1" source="b1" target="ui1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="INSERT / SELECT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#1f8756;strokeWidth=2;fontColor=#002726;fontSize=11;endArrow=block;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;labelBackgroundColor=#f2f9f6;" edge="1" parent="1" source="b2" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="rows" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#7a8f88;strokeWidth=2;dashed=1;fontColor=#002726;fontSize=11;endArrow=block;endFill=1;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;labelBackgroundColor=#f2f9f6;" edge="1" parent="1" source="b3" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="cap1" value="The server now talks to a database -- results persist even after a restart, and history can be listed back to the front-end." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#536b64;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="555" width="1160" height="35" as="geometry" />
        </mxCell>

        <mxCell id="head2" value="API SURFACE -- METHODS, STATUS CODES &amp; COMMON ERRORS" style="text;html=0;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#002726;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="800" height="24" as="geometry" />
        </mxCell>
        <mxCell id="tblHead" value="METHOD   | ENDPOINT              | SUCCESS         | COMMON ERROR(S)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#002726;strokeColor=#114741;strokeWidth=1;fontColor=#e6f5ee;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Courier New;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="630" width="1160" height="34" as="geometry" />
        </mxCell>
        <mxCell id="tblBody" value="GET      | /history              | 200 OK          | 500 Internal Server Error&#10;POST     | /calculate            | 201 Created     | 400 Bad Request (divide by zero), 422 Unprocessable Entity&#10;PUT      | /calculate/{id}       | 200 OK          | 404 Not Found&#10;DELETE   | /calculate/{id}       | 204 No Content  | 404 Not Found" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f2f9f6;strokeColor=#d9ece3;strokeWidth=1;fontColor=#002726;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontFamily=Courier New;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="664" width="1160" height="120" as="geometry" />
        </mxCell>

        <mxCell id="head3" value="ALTERNATIVE TECHNOLOGY CHOICES AT THIS STAGE" style="text;html=0;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#002726;" vertex="1" parent="1">
          <mxGeometry x="60" y="800" width="800" height="24" as="geometry" />
        </mxCell>
        <mxCell id="panelDb" value="DATABASE CHOICES&#10;&#10;- SQLite (used here)&#10;- PostgreSQL&#10;- MySQL&#10;- MongoDB (NoSQL)&#10;- Redis (cache / fast lookups)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff8e6;strokeColor=#e0a800;strokeWidth=2;fontColor=#002726;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="830" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="panelFullstack" value="FULL-STACK FRAMEWORK CHOICES&#10;&#10;- Next.js (React full-stack)&#10;- Django (Python, batteries-included)&#10;- Ruby on Rails&#10;- Laravel (PHP)&#10;- Spring Boot + Thymeleaf (Java)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf7f0;strokeColor=#33c375;strokeWidth=2;fontColor=#002726;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="660" y="830" width="560" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

