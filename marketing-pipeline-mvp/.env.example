# Marketing Pipeline MVP - Environment Config (Kore.ai D.A.R.E)
# Copy to .env: cp .env.example .env  then fill values
# All vars are optional - without them MVP runs in mock (local) mode via GET /kore/status

# --- Kore.ai XO Platform (Bot Builder, Dialogs, Web SDK) ---
# Get from Kore.ai XO Console > Bot Builder > Channels > Web/Mobile Client > App Settings
KORE_BOT_ID=st-xxxx-xxxx-xxxx-marketing-pipeline-mvp
KORE_CLIENT_ID=cs-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
KORE_CLIENT_SECRET=your_client_secret_here
KORE_BASE_URL=https://bots.kore.ai

# --- Kore.ai Search AI (RAG over data/kb/*) ---
# Get from Search AI Console > Collections > kb-marketing-pipeline > API
KORE_SEARCHAI_API_KEY=
KORE_SEARCHAI_INDEX_ID=kb-marketing-pipeline
KORE_SEARCHAI_BASE_URL=https://bots.kore.ai

# --- Kore.ai Agent AI (Tools orchestration) ---
KORE_AGENTAI_API_KEY=
KORE_AGENTAI_BASE_URL=https://bots.kore.ai

# --- CRM (choose one) ---
# HubSpot: Private App Token from HubSpot > Settings > Integrations > Private Apps
HUBSPOT_TOKEN=
# Alternative: Salesforce OAuth token (adapter auto-detects)
# SALESFORCE_TOKEN=
# HUBSPOT_API_KEY=  # legacy alias also supported

# --- Notifications ---
# Slack: Incoming Webhook from Slack > Apps > Incoming Webhooks > #sdr-hot-leads
SLACK_WEBHOOK_URL=

# --- App ---
PORT=8000
HOST=127.0.0.1
ENV=development

# Notes:
# - Empty values = mock mode (works offline, proven by GET /kore/status)
# - Set KORE_* + HUBSPOT_TOKEN to go live - see docs/06-kore-framework-usage.md
# - .env is gitignored (root .gitignore), .env.example is committed
